PROJECT_NAME="Resume Analyzer API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-jwt-key-change-this-in-production-resume-analyzer"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# Local SQLite for testing/dev, or PostgreSQL for production:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/resume_analyzer_db"
DATABASE_URL="sqlite+aiosqlite:///./resume_analyzer.db"

# Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","*"]
